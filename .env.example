APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

IP_GEOLOCATION_API_KEY=

# AgentaOS — payments (merchant of record).
# Secret key from app.agentaos.ai -> Settings -> Developers -> API Keys.
# The prefix is the environment: sk_test_... is sandbox, sk_live_... is real
# money and requires business verification to have been approved first.
AGENTAOS_API_KEY=
# Signing secret from Developer -> Webhooks, used to verify inbound webhooks.
# Without it every webhook is rejected and no payment is ever credited.
AGENTAOS_WEBHOOK_SECRET=
# UUID of the yearly subscription payment link.
# Create it once per environment with: php artisan agentaos:create-payment-link
AGENTAOS_PAYMENT_LINK_ID=
AGENTAOS_BASE_URL=https://api.agentaos.ai/api/v1

# Subscription — all optional, these are the defaults.
SUBSCRIPTION_TRIAL_DAYS=7
SUBSCRIPTION_GRACE_DAYS=7
SUBSCRIPTION_PRICE=27
SUBSCRIPTION_CURRENCY=USD
SUBSCRIPTION_DYNAMIC_QR_LIMIT=5
SUBSCRIPTION_STATIC_QR_LIMIT=50

# Where billing failures are emailed. Blank logs without emailing, which means
# a payment taken without access granted is only found by reading logs.
BILLING_ALERT_EMAIL=
BILLING_ALERT_THROTTLE_MINUTES=60

# Live subscriptions allowed to vanish from one AgentaOS listing before
# billing:sync stops closing them and alerts instead. Zero disables the cap.
SUBSCRIPTION_MAX_MISSING_PER_SYNC=10
